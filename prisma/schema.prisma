generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  role          Role         @default(STUDENT)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  enrollments   Enrollment[]
  payments      Payment[]
  paymentsRecorded Payment[] @relation("PaymentRecorder")
  coursesCreated Course[]    @relation("CourseCreator")

  @@index([role])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  summary     String
  description String       @db.Text
  priceArs    Int
  status      CourseStatus @default(DRAFT)
  coverUrl    String?
  creatorId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  creator     User         @relation("CourseCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  payments    Payment[]
  stages      CourseStage[]

  @@index([status])
  @@index([creatorId])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(PENDING)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classProgress ClassProgress[]
  quizAttempts QuizAttempt[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, status])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  courseId          String
  method            PaymentMethod
  reference         String?       @unique
  amountArs         Int
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  recordedById      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  course            Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  recordedBy        User?         @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([courseId, status])
}

model PaymentSettings {
  id                String   @id @default("default")
  institution       String?  @db.VarChar(120)
  accountHolder     String?  @db.VarChar(120)
  accountIdentifier String?  @db.VarChar(140)
  alias             String?  @db.VarChar(100)
  taxId             String?  @db.VarChar(40)
  instructions      String?  @db.Text
  updatedAt         DateTime @updatedAt
}

model CourseStage {
  id        String      @id @default(cuid())
  courseId  String
  title     String      @db.VarChar(120)
  position  Int
  createdAt DateTime    @default(now())
  updatedAt DateTime   @updatedAt
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classes   LiveClass[]

  @@unique([courseId, position])
  @@index([courseId])
}

model LiveClass {
  id             String      @id @default(cuid())
  stageId        String
  title          String      @db.VarChar(160)
  scheduledAt    DateTime
  meetingUrl     String?     @db.VarChar(500)
  recordingUrl   String?     @db.VarChar(500)
  developedTopic String?     @db.Text
  authorCredit   String?     @db.VarChar(120)
  pdfName        String?     @db.VarChar(255)
  pdfData        Bytes?
  releasedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  stage          CourseStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  progress       ClassProgress[]
  quiz           ClassQuiz?

  @@index([stageId, scheduledAt])
}

model ClassProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  liveClassId  String
  completedAt  DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  liveClass    LiveClass  @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, liveClassId])
  @@index([liveClassId])
}

model ClassQuiz {
  id             String         @id @default(cuid())
  liveClassId    String         @unique
  passingPercent Int            @default(70)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  liveClass      LiveClass      @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  questions      QuizQuestion[]
  attempts       QuizAttempt[]
}

model QuizQuestion {
  id             String    @id @default(cuid())
  quizId         String
  prompt         String    @db.VarChar(1000)
  choices        Json
  correctAnswer  String    @db.VarChar(300)
  position       Int
  quiz           ClassQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, position])
  @@index([quizId])
}

model QuizAttempt {
  id             String     @id @default(cuid())
  quizId         String
  enrollmentId   String
  answers        Json
  scorePercent   Int
  passed         Boolean
  attemptedAt    DateTime   @default(now())
  quiz           ClassQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, quizId, attemptedAt])
  @@index([quizId, passed])
}
