# PostgreSQL compatible con Prisma (local, Supabase, Neon, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth/Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"

# Cuenta de administradora creada por `npm run prisma:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="replace-with-a-strong-password"

# Upstash Redis para el rate limiting de autenticacion
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-your-upstash-token"
